# Copy to .env and change the values if needed.
POSTGRES_USER=store
POSTGRES_PASSWORD=store
POSTGRES_DB=store

# Secret used to sign JWT tokens. In a real project use a long random string.
JWT_SECRET=dev-secret-change-me

# Frontend origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173

# Password for the seeded accounts (one per role). Leave empty to generate a random one:
# it is printed once in the backend log on the first start (docker compose logs backend).
SEED_PASSWORD=

# ---------- server (./run.sh deploy, docs/DEPLOY.md) ----------
# Address of the site: ":80" — plain http by the server's IP; a domain (shop.example.ru) — HTTPS by itself.
# ./run.sh deploy writes ":80" if empty, and RUN_MODE=server (every ./run.sh command then uses
# docker-compose.prod.yml). Passwords above are replaced with random ones by ./run.sh deploy.
SITE_ADDRESS=
